# 环境变量名示例 —— 只放变量名与占位符，绝不放真实密钥。
# 本地开发请复制成 .env.local 并填入真实值；.env.local 已被 .gitignore 忽略，不会提交。

# ---------- Supabase ----------
# 新版密钥体系：publishable（前端公开，等同旧 anon）/ secret（仅服务端，等同旧 service_role）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# ---------- 高德开放平台 ----------
# Web 端(JS API) Key（前端地图）；可选第二个账号的 JS Key，前端随机挑一个以分散用量
NEXT_PUBLIC_AMAP_KEY=xxxxxxxx
NEXT_PUBLIC_AMAP_KEY_2=
# Web 端(JS API) 安全密钥 securityJsCode
NEXT_PUBLIC_AMAP_SECURITY_CODE=xxxxxxxx
# Web 服务 Key（服务端调用，如搜索/地理编码）
AMAP_WEB_SERVICE_KEY=xxxxxxxx
# Web 服务「数字签名」私钥（选填）：该 Key 在高德控制台开启了数字签名时必填，未开启留空
AMAP_WEB_SERVICE_PRIVATE_KEY=xxxxxxxx
# 第二个高德账号的 Web 服务 Key（选填）：填了即与上面的 Key 轮流使用，额度叠加（每个账号 15 万次/月）
AMAP_WEB_SERVICE_KEY_2=
AMAP_WEB_SERVICE_PRIVATE_KEY_2=
# 第三个高德账号的 Web 服务 Key（选填，同 Key 2）
AMAP_WEB_SERVICE_KEY_3=
AMAP_WEB_SERVICE_PRIVATE_KEY_3=

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxxxxxxx
